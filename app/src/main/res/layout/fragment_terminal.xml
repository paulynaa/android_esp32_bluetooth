<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFF0F4">

    <ScrollView android:id="@+id/scrollView"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/inputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/logContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp"/>
    </ScrollView>

    <LinearLayout android:id="@+id/inputBar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="#FCE4EC" android:orientation="horizontal"
        android:padding="8dp" android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&gt; " android:textColor="#C2185B" android:textSize="16sp"
            android:fontFamily="monospace"/>

        <EditText android:id="@+id/etInput"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@null"
            android:hint="type command…" android:textColorHint="#F48FB1"
            android:textColor="#37474F" android:textSize="13sp"
            android:fontFamily="monospace" android:inputType="text"
            android:imeOptions="actionSend" android:maxLines="1"/>

        <ImageButton android:id="@+id/bClear"
            android:layout_width="32dp" android:layout_height="32dp"
            android:background="#F8BBD0" android:src="@android:drawable/ic_menu_delete"
            android:scaleType="fitCenter" android:padding="6dp"
            android:layout_marginEnd="4dp"/>

        <ImageButton android:id="@+id/bSend"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="#C2185B" android:src="@android:drawable/ic_menu_send"
            android:scaleType="fitCenter" android:padding="6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>