<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFF0F4">

    <FrameLayout android:id="@+id/gameContainer"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/scoreBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout android:id="@+id/scoreBar"
        android:layout_width="0dp" android:layout_height="48dp"
        android:background="#FCE4EC" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvScore"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="SCORE: 0"
            android:textColor="#C2185B" android:textSize="14sp" android:fontFamily="monospace" android:textStyle="bold"/>
        <TextView android:id="@+id/tvBest"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BEST: 0" android:textColor="#AD1457"
            android:textSize="13sp" android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Game over overlay -->
    <LinearLayout android:id="@+id/layoutGameOver"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:background="#CCFCE4EC" android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/scoreBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GAME OVER" android:textColor="#880E4F"
            android:textSize="28sp" android:fontFamily="monospace" android:textStyle="bold"
            android:layout_marginBottom="16dp"/>
        <Button android:id="@+id/bRestart" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="RESTART"
            android:fontFamily="monospace" android:backgroundTint="#C2185B" android:textColor="#FFFFFF"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>