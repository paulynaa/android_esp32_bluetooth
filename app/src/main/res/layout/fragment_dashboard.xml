<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFF0F4">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <!-- ── LED CONTROL ───────────────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LED CONTROL" android:textColor="#880E4F" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/bLedOn" android:layout_width="0dp"
                        android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="ON" android:textSize="11sp" android:fontFamily="monospace"
                        android:backgroundTint="#E8F5E9" android:textColor="#388E3C"/>
                    <Button android:id="@+id/bLedOff" android:layout_width="0dp"
                        android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="OFF" android:textSize="11sp" android:fontFamily="monospace"
                        android:backgroundTint="#FFEBEE" android:textColor="#C62828"/>
                    <Button android:id="@+id/bLedBlink" android:layout_width="0dp"
                        android:layout_height="36dp" android:layout_weight="1"
                        android:text="BLINK" android:textSize="11sp" android:fontFamily="monospace"
                        android:backgroundTint="#EDE7F6" android:textColor="#4A148C"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SPEED" android:textColor="#9E9E9E" android:textSize="11sp"
                        android:fontFamily="monospace" android:layout_marginEnd="8dp"/>
                    <SeekBar android:id="@+id/seekBlinkSpeed" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:max="9" android:progress="4"
                        android:progressTint="#C2185B" android:thumbTint="#C2185B"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvBlinkSpeed" android:layout_width="24dp"
                        android:layout_height="wrap_content" android:text="5"
                        android:textColor="#37474F" android:textSize="12sp" android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── TEMPERATURE (auto-updating, no buttons) ── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TEMPERATURE" android:textColor="#880E4F" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">

                <!-- Chip temp row — no READ button -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="CHIP" android:textColor="#9E9E9E"
                        android:textSize="12sp" android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvChipTemp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#C2185B" android:textSize="28sp"
                        android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" °C" android:textColor="#9E9E9E" android:textSize="14sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <!-- LM35 temp row — no READ button -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="LM35" android:textColor="#9E9E9E"
                        android:textSize="12sp" android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvLm35Temp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#C2185B" android:textSize="28sp"
                        android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" °C" android:textColor="#9E9E9E" android:textSize="14sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── UPTIME ─────────────────────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="UPTIME" android:textColor="#880E4F" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="14dp" android:gravity="center">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvUptimeDays" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="#C2185B" android:textSize="28sp"
                        android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DAYS" android:textColor="#BDBDBD" android:textSize="9sp" android:fontFamily="monospace"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvUptimeHours" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="#C2185B" android:textSize="28sp"
                        android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="HRS" android:textColor="#BDBDBD" android:textSize="9sp" android:fontFamily="monospace"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvUptimeMinutes" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="#C2185B" android:textSize="28sp"
                        android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MIN" android:textColor="#BDBDBD" android:textSize="9sp" android:fontFamily="monospace"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvUptimeSeconds" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="#C2185B" android:textSize="28sp"
                        android:fontFamily="monospace" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SEC" android:textColor="#BDBDBD" android:textSize="9sp" android:fontFamily="monospace"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── MEMORY ─────────────────────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MEMORY" android:textColor="#880E4F" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/tvMemFree" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="-- KB free" android:textColor="#388E3C"
                        android:textSize="13sp" android:fontFamily="monospace"/>
                    <TextView android:id="@+id/tvMemUsed" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="-- KB used"
                        android:textColor="#C62828" android:textSize="13sp" android:fontFamily="monospace"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/progressMem"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="10dp"
                    android:max="100" android:progress="0"
                    android:progressTint="#C2185B" android:progressBackgroundTint="#F8BBD0"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvMemPercent" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="0%" android:textColor="#9E9E9E"
                        android:textSize="11sp" android:fontFamily="monospace"/>
                    <Button android:id="@+id/bReqMem" android:layout_width="wrap_content"
                        android:layout_height="28dp" android:text="REFRESH"
                        android:textSize="10sp" android:fontFamily="monospace"
                        android:backgroundTint="#FCE4EC" android:textColor="#C2185B"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── RGB LED — 4 buttons only ──────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RGB LED" android:textColor="#880E4F" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="14dp">
                <Button android:id="@+id/bRgbRed" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="RED" android:textSize="11sp" android:fontFamily="monospace"
                    android:backgroundTint="#FFEBEE" android:textColor="#C62828"/>
                <Button android:id="@+id/bRgbGreen" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="GREEN" android:textSize="11sp" android:fontFamily="monospace"
                    android:backgroundTint="#E8F5E9" android:textColor="#388E3C"/>
                <Button android:id="@+id/bRgbBlue" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="BLUE" android:textSize="11sp" android:fontFamily="monospace"
                    android:backgroundTint="#E3F2FD" android:textColor="#1565C0"/>
                <Button android:id="@+id/bRgbOff" android:layout_width="0dp"
                    android:layout_height="44dp" android:layout_weight="1"
                    android:text="OFF" android:textSize="11sp" android:fontFamily="monospace"
                    android:backgroundTint="#EFEBE9" android:textColor="#4E342E"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── BUZZER ─────────────────────────────────── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BUZZER" android:textColor="#880E4F" android:textSize="10sp"
            android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_marginBottom="6dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/bBeep" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="BEEP"
                android:fontFamily="monospace" android:textSize="11sp"
                android:backgroundTint="#E3F2FD" android:textColor="#1565C0"/>
            <Button android:id="@+id/bAlarm" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:text="ALARM"
                android:fontFamily="monospace" android:textSize="11sp"
                android:backgroundTint="#FFF3E0" android:textColor="#E65100"/>
            <Button android:id="@+id/bMute" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="MUTE" android:fontFamily="monospace" android:textSize="11sp"
                android:backgroundTint="#EFEBE9" android:textColor="#4E342E"/>
        </LinearLayout>

        <!-- ── LAST RESPONSE ──────────────────────────── -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="8dp" app:cardElevation="2dp">
            <TextView android:id="@+id/tvLastResponse" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="14dp"
                android:text="—" android:textColor="#BDBDBD"
                android:textSize="12sp" android:fontFamily="monospace"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>